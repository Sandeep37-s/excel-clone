<Window x:Class="EFM_BOM_App.AnalysisToolpakDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data Analysis Toolpak"
        Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F6F7">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Analysis Tool:" VerticalAlignment="Center" Margin="0,0,0,12" FontSize="12" FontWeight="SemiBold"/>
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbTool" Height="28" Margin="0,0,0,12" SelectedIndex="0" SelectionChanged="CmbTool_SelectionChanged">
            <ComboBoxItem Content="Descriptive Statistics"/>
            <ComboBoxItem Content="Linear Regression (X, Y)"/>
            <ComboBoxItem Content="Correlation Matrix"/>
            <ComboBoxItem Content="Moving Average"/>
        </ComboBox>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Input Range:" VerticalAlignment="Center" Margin="0,0,0,12" FontSize="12"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtInputRange" Height="26" Margin="0,0,0,12" VerticalContentAlignment="Center" Text="A1:A20"/>

        <TextBlock Grid.Row="2" Grid.Column="0" x:Name="LblParam" Text="Options:" VerticalAlignment="Center" Margin="0,0,0,12" FontSize="12"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
            <CheckBox x:Name="ChkHasHeader" Content="Labels in First Row" IsChecked="True" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <TextBlock x:Name="LblWindow" Text="Window Size:" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtWindowSize" Text="3" Width="50" Height="26" VerticalContentAlignment="Center" Visibility="Collapsed"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Output Placement:" VerticalAlignment="Center" Margin="0,0,0,12" FontSize="12"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="RbNewSheet" Content="New Worksheet" IsChecked="True" VerticalAlignment="Center" Margin="0,0,15,0"/>
            <RadioButton x:Name="RbCurrentSheet" Content="Current Worksheet (at E1)" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="4" Grid.ColumnSpan="2" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,5,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TxtToolDescription" TextWrapping="Wrap" FontSize="11" Foreground="#555555"
                           Text="Calculates standard summary statistics: Mean, Standard Error, Median, Mode, Standard Deviation, Sample Variance, Kurtosis, Skewness, Range, Min, Max, Sum, and Count."/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnRun" Content="Run Analysis" Width="105" Height="28" Margin="0,0,10,0" IsDefault="True" Click="BtnRun_Click"/>
            <Button x:Name="BtnCancel" Content="Close" Width="85" Height="28" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

