<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ExcelClone</AssemblyName>
    <ApplicationTitle>ExcelClone Professional</ApplicationTitle>
    <Product>ExcelClone Professional</Product>
    <Description>High-performance open-source desktop spreadsheet application powered by ReoGrid V3 and ClosedXML on .NET 10</Description>
    <Authors>ExcelClone Contributors</Authors>
    <Company>ExcelClone Open Source</Company>
    <Copyright>© 2026 ExcelClone Contributors. Released under the MIT License.</Copyright>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="C:\Program Files\dotnet\shared\Microsoft.WindowsDesktop.App\10.0.5\WindowsFormsIntegration.dll" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="unvell.ReoGridWPF.dll" Version="3.3.0" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="System.Drawing.Common" Version="11.0.0" />
  </ItemGroup>

</Project>
