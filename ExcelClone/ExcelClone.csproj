<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ExcelClone</AssemblyName>
    <ApplicationTitle>ExcelClone Professional</ApplicationTitle>
    <Product>ExcelClone Professional</Product>
    <Description>High-performance general-purpose desktop spreadsheet application powered by Syncfusion SfSpreadsheet on .NET 10</Description>
    <Authors>ExcelClone Technologies</Authors>
    <Company>ExcelClone Technologies</Company>
    <Copyright>© 2026 ExcelClone Technologies. All rights reserved.</Copyright>
    <Version>1.3.0</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="C:\Program Files\dotnet\shared\Microsoft.WindowsDesktop.App\10.0.5\WindowsFormsIntegration.dll" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Syncfusion.SfSkinManager.WPF" Version="35.1.46" />
    <PackageReference Include="Syncfusion.SfSpreadsheet.WPF" Version="35.1.46" />
    <PackageReference Include="Syncfusion.SfSpreadsheetHelper.WPF" Version="35.1.46" />
    <PackageReference Include="Syncfusion.Themes.Office2019Black.WPF" Version="35.1.46" />
    <PackageReference Include="Syncfusion.Themes.Office2019Colorful.WPF" Version="35.1.46" />
    <PackageReference Include="Syncfusion.Themes.Office2019DarkGray.WPF" Version="35.1.46" />
    <PackageReference Include="System.Drawing.Common" Version="11.0.0" />
  </ItemGroup>

</Project>
