<Window x:Class="EFM_BOM_App.WelcomeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to ExcelClone Professional"
        Height="540" Width="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F6F7">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar: Recent Files & Open -->
        <Border Grid.Column="0" Background="#217346" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="ExcelClone" FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="1" Text="Professional Spreadsheet Edition" FontSize="12" Foreground="#D0E8D7" Margin="0,0,0,24"/>

                <!-- Recent Files Section -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Recent Workbooks" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                    <ListBox Grid.Row="1" x:Name="ListRecentFiles" Background="Transparent" BorderThickness="0" Foreground="White"
                             MouseDoubleClick="ListRecentFiles_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                                    <TextBlock Text="{Binding Path}" FontSize="10" Foreground="#D0E8D7" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Button Grid.Row="3" Content="📁 Open Other Workbook..." Height="32" Background="#1B5E39" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Margin="0,15,0,0" Click="BtnBrowseOpen_Click"/>
            </Grid>
        </Border>

        <!-- Right Main: Templates & Quick Start -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Start a New Workbook" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <!-- Template Grid -->
            <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="0,0,0,16">
                <!-- Blank Workbook -->
                <Border Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Margin="6" Padding="14" Cursor="Hand" MouseLeftButtonUp="TplBlank_Click">
                    <StackPanel>
                        <TextBlock Text="📄" FontSize="32" Margin="0,0,0,6"/>
                        <TextBlock Text="Blank Workbook" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                        <TextBlock Text="Create a fresh empty 3-sheet spreadsheet." FontSize="11" Foreground="#666666"/>
                    </StackPanel>
                </Border>

                <!-- Financial Model -->
                <Border Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Margin="6" Padding="14" Cursor="Hand" MouseLeftButtonUp="TplFinance_Click">
                    <StackPanel>
                        <TextBlock Text="📊" FontSize="32" Margin="0,0,0,6"/>
                        <TextBlock Text="Corporate Financial Model" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                        <TextBlock Text="5-year projection model with revenue, cost and margin formulas." FontSize="11" Foreground="#666666"/>
                    </StackPanel>
                </Border>

                <!-- Manufacturing BOM -->
                <Border Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Margin="6" Padding="14" Cursor="Hand" MouseLeftButtonUp="TplBOM_Click">
                    <StackPanel>
                        <TextBlock Text="⚙️" FontSize="32" Margin="0,0,0,6"/>
                        <TextBlock Text="Manufacturing BOM Master" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                        <TextBlock Text="Parts assembly, item numbers, revisions, suppliers and costings." FontSize="11" Foreground="#666666"/>
                    </StackPanel>
                </Border>

                <!-- Project Tracker -->
                <Border Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Margin="6" Padding="14" Cursor="Hand" MouseLeftButtonUp="TplProject_Click">
                    <StackPanel>
                        <TextBlock Text="📅" FontSize="32" Margin="0,0,0,6"/>
                        <TextBlock Text="Project Milestone Tracker" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                        <TextBlock Text="Task status, start/end dates, owners and progress indicators." FontSize="11" Foreground="#666666"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Bottom Options -->
            <DockPanel Grid.Row="2">
                <CheckBox x:Name="ChkShowOnStartup" Content="Show this welcome screen on startup" IsChecked="True" VerticalAlignment="Center"/>
                <Button Content="Continue to Workbook" Width="140" Height="28" HorizontalAlignment="Right" Background="#107C41" Foreground="White" FontWeight="SemiBold" Click="BtnContinue_Click"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>

