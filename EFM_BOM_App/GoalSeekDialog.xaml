<Window x:Class="EFM_BOM_App.GoalSeekDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Goal Seek"
        Height="270" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F6F7">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Set cell:" VerticalAlignment="Center" Margin="0,0,0,12" FontSize="12"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtTargetCell" Height="26" Margin="0,0,0,12" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="To value:" VerticalAlignment="Center" Margin="0,0,0,12" FontSize="12"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtTargetValue" Height="26" Margin="0,0,0,12" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="By changing cell:" VerticalAlignment="Center" Margin="0,0,0,12" FontSize="12"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtChangingCell" Height="26" Margin="0,0,0,12" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" x:Name="TxtStatus" Text="Enter parameters and click OK to solve." FontSize="11" Foreground="#666666" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="BtnOk" Content="OK" Width="85" Height="28" Margin="0,0,10,0" IsDefault="True" Click="BtnOk_Click"/>
            <Button x:Name="BtnCancel" Content="Cancel" Width="85" Height="28" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

