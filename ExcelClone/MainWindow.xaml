<Window x:Class="ExcelClone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:rg="clr-namespace:unvell.ReoGrid;assembly=unvell.ReoGrid"
        mc:Ignorable="d"
        Title="Book1 - Excel" Height="820" Width="1340"
        WindowStartupLocation="CenterScreen"
        Background="#2B2B2B"
        TextElement.FontFamily="Segoe UI"
        TextElement.FontSize="11">

    <Window.Resources>
        <!-- Office Ribbon Colors -->
        <SolidColorBrush x:Key="OfficeDarkChrome" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="OfficeRibbonSurface" Color="#D4D4D4"/>
        <SolidColorBrush x:Key="OfficeRibbonBorder" Color="#BFBFBF"/>
        <SolidColorBrush x:Key="OfficeGreen" Color="#107C41"/>
        <SolidColorBrush x:Key="OfficeGreenHover" Color="#0E6B38"/>
        <SolidColorBrush x:Key="OfficeTextDark" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="OfficeGroupLabel" Color="#555555"/>
        <SolidColorBrush x:Key="OfficeDivider" Color="#B8B8B8"/>
        <SolidColorBrush x:Key="OfficeHover" Color="#BEBEBE"/>
        <SolidColorBrush x:Key="OfficePressed" Color="#A8A8A8"/>

        <!-- Ribbon Big Button Style (Top Icon, Bottom Text) -->
        <Style x:Key="RibbonBigBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Height" Value="68"/>
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#BEBEBE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A8A8A8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ribbon Small Button Style (Icon Left, Text Right) -->
        <Style x:Key="RibbonSmallBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="1,1"/>
            <Setter Property="Height" Value="21"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#BEBEBE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A8A8A8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ribbon Icon-Only Button Style -->
        <Style x:Key="RibbonIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="1,1"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#BEBEBE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A8A8A8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Access Toolbar Button Style -->
        <Style x:Key="QatBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3E3E3E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#505050"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Office TabControl & TabItem Template -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#E1E1E1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="11,5,11,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder" Background="{TemplateBinding Background}" CornerRadius="3,3,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="contentPresenter" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#383838"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#D4D4D4"/>
                                <Setter Property="Foreground" Value="#1A1A1A"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Tab Strip Header Row -->
                            <Border Grid.Row="0" Background="#2B2B2B" Height="31">
                                <TabPanel IsItemsHost="True" VerticalAlignment="Bottom" Margin="4,0,0,0"/>
                            </Border>
                            <!-- Active Tab Body -->
                            <Border Grid.Row="1" Background="#D4D4D4" BorderBrush="#BFBFBF" BorderThickness="0,0,0,1" MinHeight="96">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#2B2B2B">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Excel 365 Title Bar -->
            <RowDefinition Height="Auto"/> <!-- Row 1: Ribbon Bar -->
            <RowDefinition Height="Auto"/> <!-- Row 2: Formula Bar Area -->
            <RowDefinition Height="*"/>    <!-- Row 3: ReoGrid & InkCanvas -->
            <RowDefinition Height="Auto"/> <!-- Row 4: Status Bar -->
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: EXCEL 365 TITLE BAR                                                -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Background="#2B2B2B" Height="36" Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Section: Excel Green Logo + AutoSave Toggle + Quick Access Toolbar -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Excel Green Icon Badge -->
                    <Border Background="#107C41" Width="20" Height="20" CornerRadius="3" Margin="0,0,10,0" ToolTip="ExcelClone Open Source Edition">
                        <TextBlock Text="X" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- AutoSave Toggle Switch -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="AutoSave" Foreground="#E0E0E0" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Click="BtnAutoSaveToggle_Click" ToolTip="Toggle AutoSave">
                            <Border x:Name="AutoSavePill" Width="34" Height="16" CornerRadius="8" Background="#107C41" BorderBrush="#777777" BorderThickness="1">
                                <Border x:Name="AutoSaveThumb" Width="12" Height="12" CornerRadius="6" Background="#E0E0E0" HorizontalAlignment="Right" Margin="1,0"/>
                            </Border>
                        </Button>
                        <TextBlock x:Name="TxtAutoSaveStatus" Text="On" Foreground="#B0B0B0" FontSize="11" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>

                    <!-- Quick Access Icons (Save, Undo, Redo) -->
                    <Button Style="{StaticResource QatBtn}" ToolTip="Save (Ctrl+S)" Click="BtnSave_Click">
                        <TextBlock Text="💾" FontSize="12"/>
                    </Button>
                    <Button Style="{StaticResource QatBtn}" ToolTip="Undo (Ctrl+Z)" Click="BtnUndo_Click">
                        <TextBlock Text="↩" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource QatBtn}" ToolTip="Redo (Ctrl+Y)" Click="BtnRedo_Click">
                        <TextBlock Text="↪" FontSize="13"/>
                    </Button>
                    <TextBlock Text="⌄" Foreground="#777777" FontSize="10" VerticalAlignment="Center" Margin="2,0,10,0"/>

                    <Border Width="1" Background="#444444" Height="16" Margin="0,0,10,0"/>

                    <!-- Title Text -->
                    <TextBlock x:Name="HeaderTitle" Text="Book1.xlsx - Excel" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center Section: Excel 365 Search Capsule (Alt+Q) -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#383838" BorderBrush="#4C4C4C" BorderThickness="1" CornerRadius="4" Width="400" Height="26" Cursor="Hand" MouseLeftButtonUp="BtnSearch_Click">
                    <Grid Margin="8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" Foreground="#A6A6A6" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="1" Text="Search (Alt+Q)" Foreground="#A6A6A6" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Right Section: Plan Badge + Profile Avatar + Settings -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Free & Open Source Badge styled like Excel's plan button -->
                    <Border Background="#383838" BorderBrush="#4E4E4E" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,10,0" ToolTip="ExcelClone v2.0 - Free &amp; Open Source MIT">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💠" FontSize="10" Margin="0,0,4,0"/>
                            <TextBlock Text="ExcelClone Free" Foreground="#D0D0D0" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- User Profile Avatar (matching the purple 'IT' avatar from user screenshot) -->
                    <Border Width="24" Height="24" CornerRadius="12" Background="#7030A0" Margin="0,0,8,0" ToolTip="User Account">
                        <TextBlock Text="IT" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Button Style="{StaticResource QatBtn}" ToolTip="Settings" Click="BtnSettings_Click">
                        <TextBlock Text="⚙" FontSize="12"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 1: EXCEL 365 RIBBON TABS & CONTROLS                                   -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1">
            <TabControl x:Name="RibbonTabs">
            <!-- File Tab (Styled with File Operations Menu) -->
            <TabItem Header="File">
                <TabItem.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="📄 New (Ctrl+N)" Click="BtnNew_Click"/>
                        <MenuItem Header="📂 Open... (Ctrl+O)" Click="BtnOpen_Click"/>
                        <MenuItem Header="💾 Save (Ctrl+S)" Click="BtnSave_Click"/>
                        <MenuItem Header="💾 Save As..." Click="BtnSaveAs_Click"/>
                        <Separator/>
                        <MenuItem Header="🖨️ Print (Ctrl+P)" Click="BtnPrint_Click"/>
                        <MenuItem Header="📥 Import CSV..." Click="BtnImportCsv_Click"/>
                        <MenuItem Header="📤 Export CSV..." Click="BtnExportCsv_Click"/>
                        <Separator/>
                        <MenuItem Header="⚙️ Settings..." Click="BtnSettings_Click"/>
                        <MenuItem Header="ℹ️ About ExcelClone..." Click="BtnAbout_Click"/>
                    </ContextMenu>
                </TabItem.ContextMenu>
                <Border Padding="10,6" Background="#D4D4D4">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RibbonBigBtn}" Click="BtnNew_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📄" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="New" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RibbonBigBtn}" Click="BtnOpen_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📂" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Open" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RibbonBigBtn}" Click="BtnSave_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="💾" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Save" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RibbonBigBtn}" Click="BtnSaveAs_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📑" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Save As" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RibbonBigBtn}" Click="BtnPrint_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🖨️" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Print" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- Home Tab (EXACT EXCEL 365 LAYOUT) -->
            <TabItem Header="Home" IsSelected="True">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <!-- GROUP 1: Clipboard -->
                        <Grid Margin="0,0,4,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Big Paste Split Button -->
                                <Button Style="{StaticResource RibbonBigBtn}" Click="BtnPaste_Click" ToolTip="Paste (Ctrl+V)">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="📋" FontSize="24" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Paste ⌄" FontSize="10.5" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                                <!-- Stacked Cut, Copy, Format Painter -->
                                <StackPanel VerticalAlignment="Center" Margin="2,0,0,0">
                                    <Button Style="{StaticResource RibbonSmallBtn}" Click="BtnCut_Click" ToolTip="Cut (Ctrl+X)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✂" FontSize="11" Margin="0,0,4,0"/>
                                            <TextBlock Text="Cut" FontSize="10.5"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonSmallBtn}" Click="BtnCopy_Click" ToolTip="Copy (Ctrl+C)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📑" FontSize="11" Margin="0,0,4,0"/>
                                            <TextBlock Text="Copy" FontSize="10.5"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonSmallBtn}" Click="BtnFormatPainter_Click" ToolTip="Format Painter">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🖌" FontSize="11" Margin="0,0,4,0"/>
                                            <TextBlock Text="Format Painter" FontSize="10.5"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <!-- Group Label -->
                            <TextBlock Grid.Row="1" Text="Clipboard" Foreground="#555555" FontSize="9.5" HorizontalAlignment="Center" Margin="0,2,0,1"/>
                        </Grid>
                        <Border Width="1" Background="#B8B8B8" Margin="4,4"/>

                        <!-- GROUP 2: Font -->
                        <Grid Margin="0,0,4,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" VerticalAlignment="Center">
                                <!-- Row 1: Font Family + Size + Increase/Decrease -->
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,3">
                                    <ComboBox x:Name="CmbFontFamily" Width="92" Height="22" SelectedIndex="0" SelectionChanged="CmbFontFamily_SelectionChanged" VerticalContentAlignment="Center" Margin="0,0,2,0">
                                        <ComboBoxItem Content="Calibri"/>
                                        <ComboBoxItem Content="Segoe UI"/>
                                        <ComboBoxItem Content="Arial"/>
                                        <ComboBoxItem Content="Times New Roman"/>
                                        <ComboBoxItem Content="Consolas"/>
                                    </ComboBox>
                                    <ComboBox x:Name="CmbFontSize" Width="42" Height="22" SelectedIndex="2" SelectionChanged="CmbFontSize_SelectionChanged" VerticalContentAlignment="Center" Margin="0,0,3,0">
                                        <ComboBoxItem Content="9"/>
                                        <ComboBoxItem Content="10"/>
                                        <ComboBoxItem Content="11"/>
                                        <ComboBoxItem Content="12"/>
                                        <ComboBoxItem Content="14"/>
                                        <ComboBoxItem Content="16"/>
                                        <ComboBoxItem Content="18"/>
                                        <ComboBoxItem Content="20"/>
                                    </ComboBox>
                                    <Button Style="{StaticResource RibbonIconBtn}" Click="BtnIncreaseFontSize_Click" ToolTip="Increase Font Size">
                                        <TextBlock Text="A^" FontWeight="Bold" FontSize="10"/>
                                    </Button>
                                    <Button Style="{StaticResource RibbonIconBtn}" Click="BtnDecreaseFontSize_Click" ToolTip="Decrease Font Size">
                                        <TextBlock Text="Av" FontWeight="Bold" FontSize="9"/>
                                    </Button>
                                </StackPanel>
                                <!-- Row 2: Bold, Italic, Underline, Borders, Fill Yellow, Font Color -->
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource RibbonIconBtn}" Click="BtnBold_Click" ToolTip="Bold (Ctrl+B)">
                                        <TextBlock Text="B" FontWeight="Bold" FontSize="12"/>
                                    </Button>
                                    <Button Style="{StaticResource RibbonIconBtn}" Click="BtnItalic_Click" ToolTip="Italic (Ctrl+I)">
                                        <TextBlock Text="I" FontStyle="Italic" FontWeight="SemiBold" FontSize="12"/>
                                    </Button>
                                    <Button Style="{StaticResource RibbonIconBtn}" Click="BtnUnderline_Click" ToolTip="Underline (Ctrl+U)">
                                        <TextBlock Text="U̲" FontWeight="SemiBold" FontSize="11"/>
                                    </Button>
                                    <Border Width="1" Background="#B8B8B8" Height="14" Margin="2,0"/>
                                    <Button Style="{StaticResource RibbonIconBtn}" Click="BtnBorders_Click" ToolTip="All Borders">
                                        <TextBlock Text="田" FontSize="11"/>
                                    </Button>
                                    <Button Style="{StaticResource RibbonIconBtn}" Click="BtnFillYellow_Click" ToolTip="Fill Color (Yellow)">
                                        <TextBlock Text="🪣" FontSize="11"/>
                                    </Button>
                                    <Button Style="{StaticResource RibbonIconBtn}" Click="BtnFontColorRed_Click" ToolTip="Font Color (Red)">
                                        <TextBlock Text="A̲" FontWeight="Bold" Foreground="#C00000" FontSize="11"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Font" Foreground="#555555" FontSize="9.5" HorizontalAlignment="Center" Margin="0,2,0,1"/>
                        </Grid>
                        <Border Width="1" Background="#B8B8B8" Margin="4,4"/>

                        <!-- GROUP 3: Alignment -->
                        <Grid Margin="0,0,4,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" VerticalAlignment="Center">
                                <!-- Row 1: Top, Middle, Bottom Align + Orientation + Wrap Text -->
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,3">
                                    <Button Style="{StaticResource RibbonIconBtn}" Click="BtnAlignTop_Click" ToolTip="Top Align">
                                        <TextBlock Text="▔" FontSize="11"/>
                                    </Button>
                                    <Button Style="{StaticResource RibbonIconBtn}" Click="BtnAlignMiddle_Click" ToolTip="Middle Align">
                                        <TextBlock Text="-" FontSize="12"/>
                                    </Button>
                                    <Button Style="{StaticResource RibbonIconBtn}" Click="BtnAlignBottom_Click" ToolTip="Bottom Align">
                                        <TextBlock Text=" " TextDecorations="Underline" FontSize="11"/>
                                    </Button>
                                    <Button Style="{StaticResource RibbonIconBtn}" ToolTip="Orientation">
                                        <TextBlock Text="ab↗" FontSize="9"/>
                                    </Button>
                                    <Button Style="{StaticResource RibbonSmallBtn}" Margin="4,0,0,0" Click="BtnWrapText_Click" ToolTip="Wrap Text">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="↩" FontSize="10" Margin="0,0,3,0"/>
                                            <TextBlock Text="Wrap Text" FontSize="10.5"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <!-- Row 2: Align Left, Center, Align Right + Indent + Merge & Center -->
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource RibbonIconBtn}" Click="BtnAlignLeft_Click" ToolTip="Align Left">
                                        <TextBlock Text="≡" FontSize="11" HorizontalAlignment="Left"/>
                                    </Button>
                                    <Button Style="{StaticResource RibbonIconBtn}" Click="BtnAlignCenter_Click" ToolTip="Align Center">
                                        <TextBlock Text="≡" FontSize="11" HorizontalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource RibbonIconBtn}" Click="BtnAlignRight_Click" ToolTip="Align Right">
                                        <TextBlock Text="≡" FontSize="11" HorizontalAlignment="Right"/>
                                    </Button>
                                    <Button Style="{StaticResource RibbonIconBtn}" Click="BtnDecreaseIndent_Click" ToolTip="Decrease Indent">
                                        <TextBlock Text="⇤" FontSize="11"/>
                                    </Button>
                                    <Button Style="{StaticResource RibbonIconBtn}" Click="BtnIncreaseIndent_Click" ToolTip="Increase Indent">
                                        <TextBlock Text="⇥" FontSize="11"/>
                                    </Button>
                                    <Button Style="{StaticResource RibbonSmallBtn}" Margin="4,0,0,0" Click="BtnMerge_Click" ToolTip="Merge &amp; Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⬌" FontSize="10" Margin="0,0,3,0"/>
                                            <TextBlock Text="Merge &amp; Center ⌄" FontSize="10.5"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Alignment" Foreground="#555555" FontSize="9.5" HorizontalAlignment="Center" Margin="0,2,0,1"/>
                        </Grid>
                        <Border Width="1" Background="#B8B8B8" Margin="4,4"/>

                        <!-- GROUP 4: Number -->
                        <Grid Margin="0,0,3,0">
                            <Grid.RowDefinitions>
