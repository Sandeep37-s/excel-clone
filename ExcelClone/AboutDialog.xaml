<Window x:Class="ExcelClone.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About ExcelClone Professional"
        Height="420" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F6F7">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="ExcelClone Professional" FontSize="20" FontWeight="Bold" Foreground="#107C41"/>
            <TextBlock Text="Version 1.3.0 (Release Candidate) • .NET 10 Desktop" FontSize="12" Foreground="#666666" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Body Information -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="14">
            <StackPanel>
                <TextBlock Text="Product Overview" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock Text="ExcelClone Professional is an independent, general-purpose Windows desktop spreadsheet application engineered for high-performance calculation, data transformation, and OpenXML workbook manipulation."
                           FontSize="11" Foreground="#444444" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <TextBlock Text="Architecture &amp; Licensing" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock Text="• Calculation Engine: Syncfusion SfSpreadsheet on modern .NET 10&#x0a;• Numerical Analysis: MathNet.Numerics 5.0 (MIT License)&#x0a;• Security Governance: Dynamic script execution disabled (OS-level isolation required)&#x0a;• OpenXML Interoperability: Lossless .xlsx, .xls, .xlsm, .csv processing&#x0a;• Independence: ExcelClone is an independent commercial software and is not affiliated with or endorsed by Microsoft Corporation."
                           FontSize="11" Foreground="#444444" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <TextBlock Text="Publisher &amp; Support" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock Text="Publisher: ExcelClone Technologies&#x0a;Support Inquiries: support@excelclone-app.com&#x0a;Website: https://www.excelclone-app.com"
                           FontSize="11" Foreground="#444444"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Width="80" Height="26" IsDefault="True" Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>

