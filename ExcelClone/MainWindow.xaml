<syncfusion:RibbonWindow x:Class="ExcelClone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:skin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
        skin:SfSkinManager.VisualStyle="Office2019Colorful"
        mc:Ignorable="d"
        Title="ExcelClone Professional"
        Height="800" Width="1300"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- SfSpreadsheetRibbon provides full Excel-like ribbon (File/Home/Insert/PageLayout/Formulas/Data/View) -->
        <syncfusion:SfSpreadsheetRibbon Grid.Row="0"
                                        x:Name="spreadsheetRibbon"
                                        DataContext="{Binding ElementName=spreadsheetControl}"
                                        Loaded="SpreadsheetRibbon_Loaded"/>

        <!-- Native SfSpreadsheet Control (Grid, Formula Bar, Sheet Tabs, Context Menus) -->
        <syncfusion:SfSpreadsheet Grid.Row="1"
                                  x:Name="spreadsheetControl"
                                  FormulaBarVisibility="Visible"/>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Height="24">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" FontSize="11" Foreground="#333333"/>
            </StatusBarItem>
            <Separator Margin="4,2" HorizontalAlignment="Right"/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="FileInfoText" Text="Unsaved Workbook" FontSize="11" Foreground="#555555" Margin="0,0,10,0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</syncfusion:RibbonWindow>
