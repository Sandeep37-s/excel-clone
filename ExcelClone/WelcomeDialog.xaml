<Window x:Class="ExcelClone.WelcomeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ExcelClone"
        Height="720" Width="1160"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#242424"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Modern Scrollbar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Width" Value="8"/>
        </Style>

        <!-- Template Card Style -->
        <Style x:Key="TemplateCard" TargetType="Border">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="BorderBrush" Value="#3F3F3F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Width" Value="135"/>
            <Setter Property="Height" Value="145"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#107C41"/>
                    <Setter Property="Background" Value="#353535"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Left Nav Button Style -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2E2E2E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Left Nav Item -->
        <Style x:Key="ActiveNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <!-- Active Green Pill Indicator -->
                            <Rectangle Width="3" HorizontalAlignment="Left" Fill="#107C41"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Navigation Sidebar -->
            <ColumnDefinition Width="68"/>
            <!-- Main Content Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 1. LEFT NAVIGATION RAIL -->
        <Border Grid.Column="0" Background="#1D1D1D" BorderBrush="#2C2C2C" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Icon -->
                <StackPanel Grid.Row="0" Margin="0,18,0,24" HorizontalAlignment="Center">
                    <Border Background="#107C41" Width="36" Height="36" CornerRadius="4">
                        <TextBlock Text="X" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Top Navigation Items: Home, New, Open -->
                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource ActiveNavButton}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⌂" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock Text="Home" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}" Click="BtnNew_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⊕" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock Text="New" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}" Click="BtnOpen_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📁" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock Text="Open" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Bottom Navigation Items: Options -->
                <StackPanel Grid.Row="2" Margin="0,0,0,16">
                    <Button Style="{StaticResource NavButton}" Click="BtnOptions_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⚙" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock Text="Options" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MAIN BACKSTAGE AREA -->
        <Grid Grid.Column="1" Margin="40,28,40,20">
            <Grid.RowDefinitions>
                <!-- Greeting Header -->
                <RowDefinition Height="Auto"/>
                <!-- New Template Cards Section -->
                <RowDefinition Height="Auto"/>
                <!-- Search Box -->
                <RowDefinition Height="Auto"/>
                <!-- Recent Files Section Header & Tabs -->
                <RowDefinition Height="Auto"/>
                <!-- Recent Files List -->
                <RowDefinition Height="*"/>
                <!-- Bottom Preferences -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Dynamic Greeting -->
            <TextBlock Grid.Row="0" x:Name="TxtGreeting" Text="Good evening" FontSize="24" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,18"/>

            <!-- Row 1: "New" Section Header & Templates -->
            <StackPanel Grid.Row="1" Margin="0,0,0,28">
                <DockPanel Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="New" FontSize="14" FontWeight="SemiBold" Foreground="#DDDDDD" Margin="0,0,6,0"/>
                        <TextBlock Text="▾" FontSize="12" Foreground="#888888" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="More templates ➔" FontSize="12" Foreground="#107C41" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Center" MouseLeftButtonUp="TplFinance_Click"/>
                </DockPanel>

                <!-- Horizontal Template Cards -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <!-- Blank Workbook (Prominent with green accent) -->
                        <Border Style="{StaticResource TemplateCard}" BorderBrush="#107C41" BorderThickness="1.5" MouseLeftButtonUp="TplBlank_Click">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- Thumbnail Preview: Grid Graphic -->
                                <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="3" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,10">
                                    <Grid Margin="6,4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Header labels -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="A" FontSize="7" Foreground="#107C41" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="B" FontSize="7" Foreground="#888888" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="C" FontSize="7" Foreground="#888888" HorizontalAlignment="Center"/>
                                        <!-- Mini grid lines -->
                                        <Rectangle Grid.Row="1" Grid.Column="0" Fill="#E8F4EC" Margin="1" RadiusX="1" RadiusY="1"/>
                                        <Rectangle Grid.Row="1" Grid.Column="1" Fill="#F0F0F0" Margin="1" RadiusX="1" RadiusY="1"/>
                                        <Rectangle Grid.Row="1" Grid.Column="2" Fill="#F0F0F0" Margin="1" RadiusX="1" RadiusY="1"/>
                                        <Rectangle Grid.Row="2" Grid.Column="0" Fill="#F0F0F0" Margin="1" RadiusX="1" RadiusY="1"/>
                                        <Rectangle Grid.Row="2" Grid.Column="1" Fill="#F0F0F0" Margin="1" RadiusX="1" RadiusY="1"/>
                                        <Rectangle Grid.Row="2" Grid.Column="2" Fill="#F0F0F0" Margin="1" RadiusX="1" RadiusY="1"/>
                                        <Rectangle Grid.Row="3" Grid.Column="0" Fill="#F0F0F0" Margin="1" RadiusX="1" RadiusY="1"/>
                                        <Rectangle Grid.Row="3" Grid.Column="1" Fill="#F0F0F0" Margin="1" RadiusX="1" RadiusY="1"/>
                                        <Rectangle Grid.Row="3" Grid.Column="2" Fill="#F0F0F0" Margin="1" RadiusX="1" RadiusY="1"/>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Row="1" Text="Blank workbook" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Template 2: Welcome / Tour -->
                        <Border Style="{StaticResource TemplateCard}" MouseLeftButtonUp="TplWelcomeTour_Click">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="3" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,10">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Welcome" FontSize="9" FontWeight="Bold" Foreground="#107C41" HorizontalAlignment="Center"/>
                                        <TextBlock Text="➔" FontSize="14" Foreground="#107C41" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Row="1" Text="Welcome tour" FontSize="11" Foreground="#CCCCCC" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Template 3: Formula Tutorial -->
                        <Border Style="{StaticResource TemplateCard}" MouseLeftButtonUp="TplFormulaTutorial_Click">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="3" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,10">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="fx Formulas" FontSize="9" FontWeight="Bold" Foreground="#107C41" HorizontalAlignment="Center"/>
                                        <TextBlock Text="=SUM()" FontSize="8" Foreground="#555555" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Row="1" Text="Formula tutorial" FontSize="11" Foreground="#CCCCCC" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Template 4: Corporate Financial Model -->
                        <Border Style="{StaticResource TemplateCard}" MouseLeftButtonUp="TplFinance_Click">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="3" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,10">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="📊 Budget" FontSize="9" FontWeight="Bold" Foreground="#107C41" HorizontalAlignment="Center"/>
                                        <TextBlock Text="5-Yr Forecast" FontSize="8" Foreground="#666666" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Row="1" Text="Financial model" FontSize="11" Foreground="#CCCCCC" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Template 5: Product Inventory Catalog -->
                        <Border Style="{StaticResource TemplateCard}" MouseLeftButtonUp="TplInventory_Click">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="3" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,10">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="📦 Catalog" FontSize="9" FontWeight="Bold" Foreground="#107C41" HorizontalAlignment="Center"/>
                                        <TextBlock Text="SKU &amp; Stock" FontSize="8" Foreground="#666666" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Row="1" Text="Inventory catalog" FontSize="11" Foreground="#CCCCCC" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Template 6: Project Milestone Tracker -->
                        <Border Style="{StaticResource TemplateCard}" MouseLeftButtonUp="TplProject_Click">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="3" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,10">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="📅 Timeline" FontSize="9" FontWeight="Bold" Foreground="#107C41" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Milestones" FontSize="8" Foreground="#666666" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Row="1" Text="Project tracker" FontSize="11" Foreground="#CCCCCC" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>

            <!-- Row 2: Search Bar -->
            <Border Grid.Row="2" Background="#333333" BorderBrush="#444444" BorderThickness="1" CornerRadius="4" Height="32" Width="360" HorizontalAlignment="Left" Margin="0,0,0,20">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="TxtSearch" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"
                             FontSize="12" VerticalAlignment="Center" TextChanged="TxtSearch_TextChanged"/>
                    <TextBlock Grid.Column="1" x:Name="TxtSearchPlaceholder" Text="Search for a file" Foreground="#888888" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- Row 3: Recent Tabs & Header -->
            <Grid Grid.Row="3" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation Tabs: Recent / Favorites / Shared -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border BorderBrush="#107C41" BorderThickness="0,0,0,2" Padding="2,0,16,6">
                        <TextBlock Text="Recent" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    </Border>
                    <Border Padding="16,0,16,6" Cursor="Hand">
                        <TextBlock Text="Favorites" FontSize="13" Foreground="#888888"/>
                    </Border>
                    <Border Padding="16,0,16,6" Cursor="Hand">
                        <TextBlock Text="Shared with Me" FontSize="13" Foreground="#888888"/>
                    </Border>
                </StackPanel>

                <!-- Header for Date Modified -->
                <TextBlock Grid.Column="1" Text="Date modified" FontSize="11" Foreground="#888888" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,6"/>
            </Grid>

            <!-- Row 4: Recent Files List -->
            <Border Grid.Row="4" Background="#262626" BorderBrush="#333333" BorderThickness="1" CornerRadius="4">
                <ListBox x:Name="ListRecentFiles" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="ListRecentFiles_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#2D2D2D"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="itemBorder" Property="Background" Value="#333333"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="itemBorder" Property="Background" Value="#383838"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>

                                <!-- Green Excel File Icon -->
                                <Border Grid.Column="0" Background="#107C41" Width="26" Height="26" CornerRadius="3" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="X" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- File Name & Directory Subtitle -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding DisplayPath}" FontSize="10" Foreground="#888888" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Date Modified Column -->
                                <TextBlock Grid.Column="2" Text="{Binding DateModified}" FontSize="11" Foreground="#888888" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Row 5: Bottom Options -->
            <DockPanel Grid.Row="5" Margin="0,12,0,0">
                <CheckBox x:Name="ChkShowOnStartup" Content="Show this screen when ExcelClone starts" IsChecked="True" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="11"/>
                <Button Content="Continue to Workbook" Width="150" Height="28" HorizontalAlignment="Right" Background="#107C41" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Click="BtnContinue_Click"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
