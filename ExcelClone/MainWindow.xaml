                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Formula Auditing" Foreground="#555555" FontSize="9.5" HorizontalAlignment="Center" Margin="0,2,0,1"/>
                    </Grid>
                    <Border Width="1" Background="#B8B8B8" Margin="4,4"/>

                    <!-- Calculation -->
                    <Grid Margin="0,0,4,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource RibbonBigBtn}" Click="BtnRecalculate_Click" ToolTip="Calculate Now (F9)">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🔄" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Calculate Now" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Calculation" Foreground="#555555" FontSize="9.5" HorizontalAlignment="Center" Margin="0,2,0,1"/>
                    </Grid>
                </StackPanel>
            </TabItem>

            <!-- Data Tab -->
            <TabItem Header="Data">
                <StackPanel Orientation="Horizontal" Margin="6,2">
                    <!-- Get & Transform Data -->
                    <Grid Margin="0,0,4,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource RibbonBigBtn}" Click="BtnImportCsv_Click" ToolTip="From CSV Text">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📥" FontSize="22" HorizontalAlignment="Center"/>
                                    <TextBlock Text="From CSV" FontSize="10.5" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonBigBtn}" Click="BtnExportCsv_Click" ToolTip="Export to CSV">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📤" FontSize="22" HorizontalAlignment="Center"/>
                                    <TextBlock Text="To CSV" FontSize="10.5" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonBigBtn}" Click="BtnDataTransformation_Click" ToolTip="Data Studio">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="⚙" FontSize="22" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Data Studio" FontSize="10.5" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Get &amp; Transform Data" Foreground="#555555" FontSize="9.5" HorizontalAlignment="Center" Margin="0,2,0,1"/>
                    </Grid>
                    <Border Width="1" Background="#B8B8B8" Margin="4,4"/>

                    <!-- Sort & Filter -->
                    <Grid Margin="0,0,4,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource RibbonBigBtn}" Click="BtnSortAsc_Click" ToolTip="Sort A to Z">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="AZ↓" FontSize="18" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Sort A to Z" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonBigBtn}" Click="BtnSortDesc_Click" ToolTip="Sort Z to A">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="ZA↓" FontSize="18" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Sort Z to A" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonBigBtn}" Click="BtnFilter_Click" ToolTip="Filter">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🌪" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Filter" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Sort &amp; Filter" Foreground="#555555" FontSize="9.5" HorizontalAlignment="Center" Margin="0,2,0,1"/>
                    </Grid>
                    <Border Width="1" Background="#B8B8B8" Margin="4,4"/>

                    <!-- Data Tools -->
                    <Grid Margin="0,0,4,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource RibbonBigBtn}" Click="BtnDataValidation_Click" ToolTip="Data Validation">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="✅" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Data Validation" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonBigBtn}" Click="BtnRemoveDuplicates_Click" ToolTip="Remove Duplicates">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🗑" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Duplicates" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Data Tools" Foreground="#555555" FontSize="9.5" HorizontalAlignment="Center" Margin="0,2,0,1"/>
                    </Grid>
                    <Border Width="1" Background="#B8B8B8" Margin="4,4"/>

                    <!-- Forecast / Analysis -->
                    <Grid Margin="0,0,4,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource RibbonBigBtn}" Click="BtnGoalSeek_Click" ToolTip="Goal Seek">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🎯" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Goal Seek" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonBigBtn}" Click="BtnAnalysisToolpak_Click" ToolTip="Analysis Toolpak">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📈" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Analysis" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Forecast" Foreground="#555555" FontSize="9.5" HorizontalAlignment="Center" Margin="0,2,0,1"/>
                    </Grid>
                </StackPanel>
            </TabItem>

            <!-- Review Tab -->
            <TabItem Header="Review">
                <StackPanel Orientation="Horizontal" Margin="6,2">
                    <!-- Comments -->
                    <Grid Margin="0,0,4,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource RibbonBigBtn}" Click="BtnAddComment_Click" ToolTip="New Comment">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="💬" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="New Comment" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonBigBtn}" Click="BtnDeleteComment_Click" ToolTip="Delete Comment">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="❌" FontSize="18" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Delete" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonBigBtn}" Click="BtnShowComments_Click" ToolTip="Show All Comments">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📋" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Show All" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Comments" Foreground="#555555" FontSize="9.5" HorizontalAlignment="Center" Margin="0,2,0,1"/>
                    </Grid>
                    <Border Width="1" Background="#B8B8B8" Margin="4,4"/>

                    <!-- Protect -->
                    <Grid Margin="0,0,4,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource RibbonBigBtn}" Click="BtnProtectSheet_Click" ToolTip="Protect Sheet">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🔒" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Protect Sheet" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonBigBtn}" Click="BtnUnprotectSheet_Click" ToolTip="Unprotect Sheet">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🔓" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Unprotect" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonBigBtn}" Click="BtnProtectWorkbook_Click" ToolTip="Protect Workbook">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🛡" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Workbook" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Protect" Foreground="#555555" FontSize="9.5" HorizontalAlignment="Center" Margin="0,2,0,1"/>
                    </Grid>
                </StackPanel>
            </TabItem>

            <!-- View Tab -->
            <TabItem Header="View">
                <StackPanel Orientation="Horizontal" Margin="6,2">
                    <!-- Window / Freeze Panes -->
                    <Grid Margin="0,0,4,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource RibbonBigBtn}" Click="BtnFreezePanes_Click" ToolTip="Freeze Panes">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="❄" FontSize="22" HorizontalAlignment="Center" Foreground="#0078D7"/>
                                    <TextBlock Text="Freeze Panes" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonBigBtn}" Click="BtnUnfreezePanes_Click" ToolTip="Unfreeze Panes">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="☀️" FontSize="22" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Unfreeze" FontSize="10.5" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Window" Foreground="#555555" FontSize="9.5" HorizontalAlignment="Center" Margin="0,2,0,1"/>
                    </Grid>
                    <Border Width="1" Background="#B8B8B8" Margin="4,4"/>

                    <!-- Zoom -->
                    <Grid Margin="0,0,4,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource RibbonBigBtn}" Click="BtnZoomReset_Click" ToolTip="Zoom 100%">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🔍" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="100%" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonBigBtn}" Click="BtnZoomIn_Click" ToolTip="Zoom In">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="➕" FontSize="18" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Zoom In" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonBigBtn}" Click="BtnZoomOut_Click" ToolTip="Zoom Out">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="➖" FontSize="18" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Zoom Out" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Zoom" Foreground="#555555" FontSize="9.5" HorizontalAlignment="Center" Margin="0,2,0,1"/>
                    </Grid>
                    <Border Width="1" Background="#B8B8B8" Margin="4,4"/>

                    <!-- Theme -->
                    <Grid Margin="0,0,4,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource RibbonBigBtn}" Click="BtnToggleTheme_Click" ToolTip="Toggle Dark Gray / Colorful Theme">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🎨" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Theme" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Theme" Foreground="#555555" FontSize="9.5" HorizontalAlignment="Center" Margin="0,2,0,1"/>
                    </Grid>
                </StackPanel>
            </TabItem>

            <!-- Help Tab -->
            <TabItem Header="Help">
                <StackPanel Orientation="Horizontal" Margin="6,2">
                    <Grid Margin="0,0,4,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource RibbonBigBtn}" Click="BtnShortcuts_Click" ToolTip="Help">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="❓" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Help" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonBigBtn}" Click="BtnShortcuts_Click" ToolTip="Keyboard Shortcuts (F1)">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="⌨" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Shortcuts" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonBigBtn}" Click="BtnAbout_Click" ToolTip="About ExcelClone">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="ℹ" FontSize="20" HorizontalAlignment="Center" Foreground="#107C41"/>
                                    <TextBlock Text="About" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Help" Foreground="#555555" FontSize="9.5" HorizontalAlignment="Center" Margin="0,2,0,1"/>
                    </Grid>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Tab Strip Right Utilities (Comments, Share, Collapse) -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Height="31" Orientation="Horizontal" Margin="0,0,10,0">
            <Button Style="{StaticResource QatBtn}" Padding="8,4" Margin="0,0,6,0" Click="BtnShowComments_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💬" Margin="0,0,4,0" FontSize="11"/>
                    <TextBlock Text="Comments" Foreground="#E0E0E0" FontSize="11"/>
                </StackPanel>
            </Button>
            <Button Background="#107C41" Foreground="#FFFFFF" BorderThickness="0" Padding="12,3" Margin="0,0,8,0" Cursor="Hand" Click="BtnShare_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="3"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔗" Margin="0,0,5,0" FontSize="10"/>
                    <TextBlock Text="Share" FontWeight="SemiBold" FontSize="11"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource QatBtn}" Width="24" Height="24" Click="BtnCollapseRibbon_Click" ToolTip="Collapse / Expand Ribbon">
                <TextBlock Text="⌃" Foreground="#A0A0A0" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>
        </StackPanel>
    </Grid>

        <!-- ========================================================================= -->
        <!-- ROW 2: FORMULA BAR AREA (DARK GRAY OFFICE THEME)                          -->
        <!-- ========================================================================= -->
        <Border Grid.Row="2" Background="#383838" BorderBrush="#2C2C2C" BorderThickness="0,0,0,1" Padding="6,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Name Box -->
                    <ColumnDefinition Width="Auto"/> <!-- Divider -->
                    <ColumnDefinition Width="Auto"/> <!-- Cancel, Enter, fx -->
                    <ColumnDefinition Width="*"/>    <!-- Formula Input -->
                    <ColumnDefinition Width="Auto"/> <!-- Expand Chevron -->
                </Grid.ColumnDefinitions>

                <!-- Name Box (Dropdown Capsule) -->
                <Border Grid.Column="0" Background="#2B2B2B" BorderBrush="#4E4E4E" BorderThickness="1" CornerRadius="2" Width="82" Height="22" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtNameBox" Grid.Column="0" Text="A1" FontWeight="SemiBold" Foreground="#FFFFFF" Background="Transparent" BorderThickness="0" TextAlignment="Center" VerticalAlignment="Center" IsReadOnly="True" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="⌄" Foreground="#888888" FontSize="10" VerticalAlignment="Center" Margin="0,-2,4,0"/>
                    </Grid>
                </Border>

                <!-- Divider -->
                <Border Grid.Column="1" Width="1" Background="#4E4E4E" Height="16" Margin="6,0"/>

                <!-- Formula Action Buttons: Cancel, Enter, fx -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button Width="20" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnFormulaCancel_Click" ToolTip="Cancel (Esc)">
                        <TextBlock Text="✕" Foreground="#888888" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="20" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnFormulaEnter_Click" ToolTip="Enter">
                        <TextBlock Text="✓" Foreground="#888888" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="22" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnAutoSum_Click" ToolTip="Insert Function">
                        <TextBlock Text="fx" FontStyle="Italic" FontWeight="Bold" FontSize="13" Foreground="#A8A8A8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <!-- Formula Bar Input -->
                <TextBox x:Name="TxtFormulaBar" Grid.Column="3" Background="#252525" BorderBrush="#484848" BorderThickness="1" Foreground="#FFFFFF" CaretBrush="#FFFFFF" Padding="6,2" VerticalAlignment="Center" Height="22" FontSize="11.5" KeyDown="TxtFormulaBar_KeyDown"/>

                <!-- Expand Chevron -->
                <TextBlock Grid.Column="4" Text="⌄" Foreground="#888888" FontSize="11" VerticalAlignment="Center" Margin="6,0,4,0" Cursor="Hand" ToolTip="Expand Formula Bar"/>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 3: SPREADSHEET GRID & INKCANVAS LAYER                                 -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="3" Background="#FFFFFF">
            <rg:ReoGridControl x:Name="gridControl"/>
            <InkCanvas x:Name="drawingCanvas" Visibility="Collapsed" Background="Transparent"/>
        </Grid>

        <!-- ========================================================================= -->
        <!-- ROW 4: STATUS BAR (DARK CHARCOAL OFFICE THEME)                            -->
        <!-- ========================================================================= -->
        <Border Grid.Row="4" Background="#202020" BorderBrush="#303030" BorderThickness="0,1,0,0" Height="26" Padding="10,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Status Text -->
                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#E0E0E0" Text="Ready" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <!-- Middle: Accessibility Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="✓" Foreground="#107C41" FontWeight="Bold" FontSize="11" Margin="0,0,4,0"/>
                    <TextBlock Text="Accessibility: Good to go" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center"/>
                    <Border Width="1" Background="#3A3A3A" Height="14" Margin="12,0"/>
                    <TextBlock x:Name="StatusCell" Foreground="#A0A0A0" Text="Cell: A1" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: View Modes + Zoom Controls -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- View Mode Buttons -->
                    <Button Width="20" Height="20" Background="Transparent" BorderThickness="0" Margin="1,0" ToolTip="Normal View">
                        <TextBlock Text="⊞" Foreground="#A0A0A0" FontSize="11" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Width="20" Height="20" Background="Transparent" BorderThickness="0" Margin="1,0" ToolTip="Page Layout View">
                        <TextBlock Text="📄" Foreground="#A0A0A0" FontSize="10" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Width="20" Height="20" Background="Transparent" BorderThickness="0" Margin="1,0" ToolTip="Page Break Preview">
                        <TextBlock Text="📑" Foreground="#A0A0A0" FontSize="10" HorizontalAlignment="Center"/>
                    </Button>

                    <Border Width="1" Background="#3A3A3A" Height="14" Margin="6,0"/>

                    <!-- Zoom Controls -->
                    <Button Width="18" Height="18" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnZoomOut_Click" ToolTip="Zoom Out">
                        <TextBlock Text="—" Foreground="#CCCCCC" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Slider Width="90" Minimum="50" Maximum="200" Value="100" ValueChanged="SliderZoom_ValueChanged" VerticalAlignment="Center" Margin="4,0"/>

                    <Button Width="18" Height="18" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnZoomIn_Click" ToolTip="Zoom In">
                        <TextBlock Text="+" Foreground="#CCCCCC" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnZoomReset_Click" ToolTip="Reset Zoom (100%)">
                        <TextBlock x:Name="TxtZoomPercent" Text="100%" Foreground="#FFFFFF" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>