<Window x:Class="ExcelClone.ShortcutsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ExcelClone — Keyboard Shortcuts Reference"
        Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F6F7">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Keyboard Shortcuts Reference" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl + N" FontWeight="Bold" Margin="0,3"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Create a new workbook" Margin="0,3"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl + O" FontWeight="Bold" Margin="0,3"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Open an existing spreadsheet" Margin="0,3"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl + S" FontWeight="Bold" Margin="0,3"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Save current workbook" Margin="0,3"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl + Z / Ctrl + Y" FontWeight="Bold" Margin="0,3"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Undo / Redo action" Margin="0,3"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Ctrl + C / Ctrl + V" FontWeight="Bold" Margin="0,3"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Copy / Paste selected cell range" Margin="0,3"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Ctrl + B / I / U" FontWeight="Bold" Margin="0,3"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="Bold, Italic, or Underline formatting" Margin="0,3"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="F2" FontWeight="Bold" Margin="0,3"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="Edit the active cell directly" Margin="0,3"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="F4" FontWeight="Bold" Margin="0,3"/>
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="Cycle absolute reference ($A$1 -> A$1 -> $A1 -> A1)" Margin="0,3"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Ctrl + F / Ctrl + H" FontWeight="Bold" Margin="0,3"/>
                    <TextBlock Grid.Row="8" Grid.Column="1" Text="Find and Replace dialog" Margin="0,3"/>

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Ctrl + Arrow Keys" FontWeight="Bold" Margin="0,3"/>
                    <TextBlock Grid.Row="9" Grid.Column="1" Text="Jump to edge of current data region" Margin="0,3"/>

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Ctrl + Shift + Arrow" FontWeight="Bold" Margin="0,3"/>
                    <TextBlock Grid.Row="10" Grid.Column="1" Text="Extend selection to edge of data region" Margin="0,3"/>

                    <TextBlock Grid.Row="11" Grid.Column="0" Text="Delete" FontWeight="Bold" Margin="0,3"/>
                    <TextBlock Grid.Row="11" Grid.Column="1" Text="Clear contents of selected cells" Margin="0,3"/>

                    <TextBlock Grid.Row="12" Grid.Column="0" Text="F9" FontWeight="Bold" Margin="0,3"/>
                    <TextBlock Grid.Row="12" Grid.Column="1" Text="Recalculate all formulas across active sheets" Margin="0,3"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" Width="80" Height="26" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

